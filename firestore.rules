rules_version = '2';
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 이 내용을 그대로 붙여넣고 게시하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    // 한국 시간 기준 오늘 날짜 번호 (서버 시각으로 계산하므로 기기 시계를 바꿔도 소용없음)
    function today() {
      return math.floor((request.time.toMillis() + 32400000) / 86400000);
    }

    function validShape(d) {
      return d.keys().hasOnly(['name', 'tokens', 'refills', 'day'])
        && d.name is string && d.name.size() <= 12
        && d.tokens is int && d.tokens >= 0 && d.tokens <= 100000000
        && d.refills is int && d.refills >= 0 && d.refills <= 10
        && d.day == today();
    }

    // 재지급은 하루 10번까지, 한 번에 1회씩, 받을 때는 정확히 기본 토큰(1000)
    function refillOk(o, n) {
      let base = o.day == n.day ? o.refills : 0;
      return n.refills == base || (n.refills == base + 1 && n.tokens == 1000);
    }

    // 관리자: admins/{uid} 문서가 있는 계정 (콘솔에서 직접 추가. 앱에서는 만들 수 없음)
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /players/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && validShape(request.resource.data)
        && request.resource.data.tokens == 1000
        && request.resource.data.refills == 0;
      allow update: if request.auth != null && request.auth.uid == uid
        && validShape(request.resource.data)
        && refillOk(resource.data, request.resource.data);
      allow delete: if false;
    }

    // ---------- 사용 통계 (기록은 누구나 자기 것만, 보기는 관리자만) ----------
    match /stats_days/{day}/users/{uid} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid && day.size() == 10
        && request.resource.data.keys().hasOnly(['at', 'isNew', 'via'])
        && request.resource.data.at == request.time
        && request.resource.data.get('isNew', false) is bool
        && request.resource.data.get('via', 'direct') in ['invite', 'direct'];
    }

    // ---------- 공개 방 목록 (방장만 올리고, 방장이 나가면 그 방에 있던 사람이 이어받음) ----------
    function lobbyShape(d) {
      return d.keys().hasOnly(['name', 'humans', 'bots', 'playing', 'members', 'hostUid', 'v', 'at'])
        && d.name is string && d.name.size() <= 12
        && d.humans is int && d.humans >= 0 && d.humans <= 6
        && d.bots is int && d.bots >= 0 && d.bots <= 6
        && d.playing is bool
        && d.members is list && d.members.size() <= 6
        && d.v is string && d.v.size() <= 10
        && d.hostUid == request.auth.uid
        && request.auth.uid in d.members
        && d.at == request.time;
    }
    match /lobby/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && code.size() <= 8 && lobbyShape(request.resource.data);
      allow update: if request.auth != null && lobbyShape(request.resource.data)
        && request.auth.uid in resource.data.members;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    // ---------- 주간 시즌 랭킹 (로그인하면 누구나 보기, 기록은 자기 것만 한 판씩) ----------
    function seasonShape(d) {
      return d.keys().hasOnly(['name', 'net', 'hands', 'wins', 'at'])
        && d.name is string && d.name.size() <= 12
        && d.net is int && d.hands is int && d.wins is int
        && d.at == request.time;
    }
    match /seasons/{season}/players/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && season.size() == 10
        && seasonShape(request.resource.data)
        && request.resource.data.hands == 1
        && request.resource.data.wins >= 0 && request.resource.data.wins <= 1
        && request.resource.data.net >= -10000000 && request.resource.data.net <= 10000000;
      allow update: if request.auth != null && request.auth.uid == uid
        && seasonShape(request.resource.data)
        && request.resource.data.hands == resource.data.hands + 1
        && request.resource.data.wins >= resource.data.wins
        && request.resource.data.wins <= resource.data.wins + 1
        && request.resource.data.net - resource.data.net >= -10000000
        && request.resource.data.net - resource.data.net <= 10000000;
      allow delete: if false;
    }
    match /stats_days/{day}/rooms/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null && day.size() == 10
        && request.resource.data.keys().hasOnly(['by', 'code', 'at', 'maxPlayers', 'hands'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.code is string && request.resource.data.code.size() <= 8
        && request.resource.data.at == request.time
        && request.resource.data.maxPlayers == 1
        && request.resource.data.hands == 0;
      // 방을 만든 사람만, 판 수는 한 번에 1씩, 인원은 1~6
      allow update: if request.auth != null && resource.data.by == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hands', 'maxPlayers'])
        && request.resource.data.hands is int
        && request.resource.data.hands >= resource.data.hands
        && request.resource.data.hands <= resource.data.hands + 1
        && request.resource.data.maxPlayers is int
        && request.resource.data.maxPlayers >= 1 && request.resource.data.maxPlayers <= 6;
    }

    // ---------- 중계 (직접 연결이 안 될 때 게임 메시지를 전달) ----------
    function signedIn() { return request.auth != null; }

    match /rooms/{code}/peers/{peerId} {
      // 방에 누가 있는지는 로그인한 사람이면 볼 수 있음 (계정 uid와 접속 시각만 저장)
      allow read: if signedIn();
      allow create: if signedIn() && peerId.size() <= 64
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /rooms/{code}/msgs/{id} {
      // 메시지는 받는 사람만 읽을 수 있음 (다른 사람의 카드가 새지 않도록)
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'toUid', 'from', 'fromUid', 'a', 'd', 'n', 't'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.a is string && request.resource.data.a.size() <= 10
        && request.resource.data.d is string && request.resource.data.d.size() <= 20000
        && request.resource.data.n is int
        && request.resource.data.t == request.time;
      allow delete: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow update: if false;
    }
  }
}
